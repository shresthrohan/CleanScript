LOAD "students_extended.csv";
REMOVE_DUPLICATES;
FILL_NULLS AGE USING MEDIAN;
FILL_NULLS MARKS USING MEAN;
FILL_NULLS CITY USING MODE;
DROP_COLUMN "HOME ADDRESS";
RENAME "STUDENT NAME" TO NAME;
FILTER STATUS == "ACTIVE";
FILTER AGE >= 18;
NORMALIZE MARKS;
SORT MARKS DESC;
SAVE "cleaned_students_extended.csv";
