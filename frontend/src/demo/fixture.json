  "generated_code": "# Generated by the CleanScript compiler from validated IR.\n# CleanScript itself runs the IR through a restricted interpreter with the same\n# semantics; this script is the equivalent Pandas program, shown for inspection.\nimport pandas as pd\n\n# LOAD 'students.csv' (the managed upload for this session)\ndf = pd.read_csv('students.csv', dtype_backend='numpy_nullable')\n\n# [1] FILL_NULLS 'AGE' USING MEDIAN  (line 2)\nif df['AGE'].isna().all():\n    raise ValueError(\"FILL_NULLS: column 'AGE' has no non-null values\")\nfill_value = df['AGE'].median()\nif pd.api.types.is_integer_dtype(df['AGE']) and not float(fill_value).is_integer():\n    df['AGE'] = df['AGE'].astype('Float64')\ndf['AGE'] = df['AGE'].fillna(fill_value)\n\n# [2] FILL_NULLS 'MARKS' USING MEAN  (line 3)\nif df['MARKS'].isna().all():\n    raise ValueError(\"FILL_NULLS: column 'MARKS' has no non-null values\")\nfill_value = df['MARKS'].mean()\nif pd.api.types.is_integer_dtype(df['MARKS']) and not float(fill_value).is_integer():\n    df['MARKS'] = df['MARKS'].astype('Float64')\ndf['MARKS'] = df['MARKS'].fillna(fill_value)\n\n# [3] REMOVE_DUPLICATES  (line 4)\ndf = df.drop_duplicates(keep='first')\n\n# [4] FILTER 'AGE' >= 18  (line 5)\ndf = df[df['AGE'].notna() & (df['AGE'] >= 18)]  # nulls never match\n\n# [5] NORMALIZE 'MARKS'  (line 6)\nif df['MARKS'].isna().all():\n    raise ValueError(\"NORMALIZE: column 'MARKS' has no non-null values\")\nvalues = df['MARKS'].astype('Float64')\ncol_min, col_max = values.min(), values.max()\nif col_max == col_min:\n    df['MARKS'] = values.where(values.isna(), 0.0)  # constant column -> 0.0\nelse:\n    df['MARKS'] = (values - col_min) / (col_max - col_min)\n\n# [6] SORT 'MARKS' DESC  (line 7)\ndf = df.sort_values('MARKS', ascending=False, kind='stable', na_position='last')\n\n# SAVE 'cleaned_students.csv'\ndf.to_csv('cleaned_students.csv', index=False, lineterminator='\\n')\n",
